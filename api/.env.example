# Copier en api/.env pour le développement local (jamais commité).
# En production ces valeurs viennent du Secret Kubernetes `api-env` (infra/k8s).

PORT=3000
DATABASE_URL=postgres://followmetravel:motdepasse@localhost:5432/followmetravel

# Origines du front autorisées (CORS + redirections OAuth / récupération).
FRONT_ORIGINS=http://localhost:5173,https://followmetravel.ma,https://www.followmetravel.ma
# URL publique de l'API (redirect_uri Google).
API_PUBLIC_URL=http://localhost:3000

# Signature des cookies — `openssl rand -hex 32`.
SESSION_SECRET=
# false en local (http), true en production.
COOKIE_SECURE=false
# lax si front et API partagent le domaine (api.followmetravel.ma) ; none sinon.
COOKIE_SAMESITE=lax
SESSION_DAYS=30

# MinIO / S3
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=followmetravel
MEDIA_PUBLIC_URL=http://localhost:9000/followmetravel

# Google OAuth (console Google Cloud → Identifiants → ID client OAuth « Application Web »).
# URI de redirection autorisée : ${API_PUBLIC_URL}/v1/account/sessions/oauth2/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP (boîte noreply du cPanel), ex. :
# smtps://noreply%40followmetravel.ma:motdepasse@mail.followmetravel.ma:465
SMTP_URL=
MAIL_FROM=Follow Me Travel <noreply@followmetravel.ma>

# reCAPTCHA v3 (clé secrète, côté serveur). RECAPTCHA_DISABLED=true uniquement en local.
RECAPTCHA_SECRET=
RECAPTCHA_DISABLED=false
RECAPTCHA_MIN_SCORE=0.5
