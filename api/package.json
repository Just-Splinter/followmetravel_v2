{
  "name": "followmetravel-api",
  "private": true,
  "version": "0.1.0",
  "description": "API NestJS de followmetravel — remplace Appwrite (auth, documents, fichiers, réservations, emails).",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.build.json && node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "user:create": "node --env-file-if-exists=.env dist/cli/create-user.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/throttler": "6.7.1",
    "argon2": "0.45.1",
    "cookie-parser": "1.4.7",
    "exceljs": "^4.4.0",
    "minio": "8.0.7",
    "nodemailer": "10.1.1",
    "pdfkit": "0.17.2",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
