# Copy this file to .env and fill in real values. Never commit .env.
# Note: VITE_-prefixed vars are inlined into the client bundle at build time —
# they are NOT secret. Fine for public Appwrite endpoint/project/collection IDs,
# NOT fine for API keys that must stay server-side (see VITE_DEEPSEEK_API_KEY below).

VITE_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=6a235696000b424aa0e5
VITE_APPWRITE_DATABASE_ID=6a235cbd002838f30b11
VITE_APPWRITE_BUCKET_ID=6a2727ac0007593f1cf4

# Appwrite Function that sends a template email (email_templates collection
# + Appwrite Messaging). Deploy the function first, then paste its Function
# ID here — until it's set, sendTriggerEmail() (services/emailSender.js) is
# a silent no-op, so the Notifications toggles in Paramètres save fine but
# don't send anything yet.
VITE_APPWRITE_EMAIL_FUNCTION_ID=

# TEMPORARY stopgap only: this key still ships in the client bundle when set,
# so it is not actually secret. Do not put a real production key here until
# the DeepSeek calls are moved behind a server-side proxy (e.g. an Appwrite
# Function). See AIAgent.jsx / Isoterm.jsx / TravelPageSite.jsx / Travelpagemobile.jsx.
VITE_DEEPSEEK_API_KEY=

# OpenRouter — traductions automatiques du contenu (dashboard)
OPENROUTER_API_KEY=
# optionnel : forcer un modèle précis
VITE_OPENROUTER_MODEL=
