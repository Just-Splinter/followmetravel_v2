# Copy this file to .env and fill in real values. Never commit .env.
# Note: VITE_-prefixed vars are inlined into the client bundle at build time —
# they are NOT secret. Fine for public URLs (API, media),
# NOT fine for API keys that must stay server-side (see VITE_DEEPSEEK_API_KEY below).

# API followmetravel (api/ — NestJS). En local : cd api && npm run dev.
VITE_API_URL=http://localhost:3000
# Base publique des images (bucket MinIO), sans slash final.
VITE_MEDIA_URL=https://s3-followmetravel.oneiro-lego.com/followmetravel

# TEMPORARY stopgap only: this key still ships in the client bundle when set,
# so it is not actually secret. Do not put a real production key here until
# the DeepSeek calls are moved behind a server-side proxy (the API). See AIAgent.jsx / Isoterm.jsx / TravelPageSite.jsx / Travelpagemobile.jsx.
VITE_DEEPSEEK_API_KEY=

# OpenRouter — traductions automatiques du contenu (dashboard)
OPENROUTER_API_KEY=
# optionnel : forcer un modèle précis
VITE_OPENROUTER_MODEL=
